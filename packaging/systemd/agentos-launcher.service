[Unit]
Description=AgentOS NLP Launcher (always-on-top chat bar)
Documentation=https://agentos.dev/docs/desktop
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m agentos.shell.launcher
WorkingDirectory=/usr/lib/agentos
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/agentos/agentos.env

[Install]
WantedBy=graphical-session.target
